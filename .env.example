# ── Option A: Docker (Recommended — no PostgreSQL install needed) ──────────
# Run:  docker-compose up -d
# Then use these credentials exactly as-is:
DATABASE_URL=postgresql://analyst:analyst123@localhost:5433/ecommerce_analytics

# ── Option B: Local PostgreSQL install ─────────────────────────────────────
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DBNAME
# Replace postgres and yourpassword with your actual credentials:
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/ecommerce_analytics

# ── Groq API Key (FREE — no credit card needed) ────────────────────────────
# Sign up at: https://console.groq.com → API Keys → Create Free Key
# Model used: llama-3.3-70b-versatile (free tier)
GROQ_API_KEY=your_groq_api_key_here
